// File name: capstone/CPU.hdl

/**
 * The Hack Central Processing unit (CPU).
 * Parses the current instruction and executes it according to the
 * Hack machine language specification.
 */

CHIP CPU {

    IN  inM[16],         // M value input  (M = contents of RAM[A])
        instruction[16], // Instruction for execution
        reset;           // Signals whether to re-start the current
                         // program (reset==1) or continue executing
                         // the current program (reset==0).

    OUT outM[16],        // M value output
        writeM,          // Write to M? 
        addressM[15],    // Address in data memory (of M)
        pc[15];          // address of next instruction

    PARTS:
    // Instruction decoding:
    // instruction[15]: 0 = A-instruction, 1 = C-instruction
    Not(in=instruction[15], out=isAInstruction);
    Or(a=isAInstruction, b=instruction[5], out=loadA);

    // Mux before A-Register: selects instruction bits if A-instruction, or ALU output if C-instruction
    Mux16(a=instruction, b=ALUout, sel=instruction[15], out=inA);
    ARegister(in=inA, load=loadA, out=outA, out[0..14]=addressM);

    // Mux before ALU: selects A-Register or memory input inM based on instruction[12] (the 'a' bit)
    Mux16(a=outA, b=inM, sel=instruction[12], out=AMout);

    // D-Register load: enabled if C-instruction and instruction[4] (d2 bit) is 1
    And(a=instruction[15], b=instruction[4], out=loadD);
    DRegister(in=ALUout, load=loadD, out=outD);

    // Arithmetic Logic Unit (ALU)
    ALU(x=outD, y=AMout,
        zx=instruction[11], nx=instruction[10],
        zy=instruction[9],  ny=instruction[8],
        f=instruction[7],   no=instruction[6],
        out=ALUout, out=outM, zr=zr, ng=ng);

    // Memory write flag (writeM): enabled if C-instruction and instruction[3] (d3 bit) is 1
    And(a=instruction[15], b=instruction[3], out=writeM);

    // Jump Evaluation:
    // zr: ALU output is zero
    // ng: ALU output is negative
    // positive: neither zero nor negative
    Not(in=zr, out=notZr);
    Not(in=ng, out=notNg);
    And(a=notZr, b=notNg, out=pos);

    // Test the 3 jump condition bits (j1=JLT, j2=JEQ, j3=JGT)
    And(a=instruction[2], b=ng, out=jlt);
    And(a=instruction[1], b=zr, out=jeq);
    And(a=instruction[0], b=pos, out=jgt);

    // Combine conditions
    Or(a=jlt, b=jeq, out=jle);
    Or(a=jle, b=jgt, out=jumpCond);

    // Jump is only executed for C-instructions
    And(a=instruction[15], b=jumpCond, out=loadPC);
    Not(in=loadPC, out=incPC);

    // Program Counter (PC): loads jump address from A register, or increments by 1
    PC(in=outA, load=loadPC, inc=incPC, reset=reset, out[0..14]=pc);
}
